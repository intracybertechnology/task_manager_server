# ─────────────────────────────────────────────────────────────────────────────
# Worklog Pro — server environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# development | production. In production, SQL query logging is off.
NODE_ENV=development

# Port the API listens on.
PORT=5000

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# PostgreSQL connection string. This is the database the app uses.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_management

# WARNING: if DATABASE_URL is empty and none of the DB_* settings below are set,
# the app falls back to the SQLite file at server/data/database.sqlite.
# That file is stale and separate — do not rely on it. Leave DATABASE_URL set.

# Alternative to DATABASE_URL: individual settings. Only used when
# DATABASE_URL is empty AND DB_DIALECT=postgres.
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=task_management
# DB_USER=postgres
# DB_PASSWORD=postgres

# Only used by the SQLite fallback (not recommended). Path to the SQLite file.
# SQLITE_STORAGE=./data/database.sqlite

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Signing secret for login tokens. The app refuses to start if this is missing.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Token lifetime, e.g. 24h, 8h, 7d.
JWT_EXPIRES_IN=24h

# ── CORS (set this in production) ────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated, full origins
# including the scheme. Defaults to http://localhost:5173 when unset, so the
# live frontend is blocked unless its URL is listed here.
# Example: CORS_ORIGIN=https://worklog.example.com,https://www.worklog.example.com
CORS_ORIGIN=http://localhost:5173

# ── Attendance ───────────────────────────────────────────────────────────────
# IANA time zone used for "today", the attendance cutoff and dated jobs.
# The browser's clock is never trusted for these.
COMPANY_TIMEZONE=Asia/Kolkata

# Daily cutoff (24-hour, company time zone). On a working day, anyone who has
# not marked attendance by this time is recorded Absent by a scheduled job;
# only an admin can change it afterwards. No cutoff runs on company off days.
ATTENDANCE_CUTOFF_HOUR=11
ATTENDANCE_CUTOFF_MINUTE=55
